rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function platformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }
    function membershipId(gymId) { return gymId + '_' + request.auth.uid; }
    function membership(gymId) {
      return get(/databases/$(database)/documents/gym_memberships/$(membershipId(gymId))).data;
    }
    function activeGym(gymId) {
      return signedIn() && membership(gymId).status == 'active' &&
        get(/databases/$(database)/documents/gyms/$(gymId)).data.status in ['trial', 'active'] &&
        (!('platformPlanEndsAt' in get(/databases/$(database)/documents/gyms/$(gymId)).data) ||
         get(/databases/$(database)/documents/gyms/$(gymId)).data.platformPlanEndsAt > request.time);
    }
    function role(gymId, allowed) {
      return activeGym(gymId) && membership(gymId).role in allowed;
    }
    function permission(gymId, key) {
      return activeGym(gymId) && membership(gymId).permissions[key] == true;
    }
    function tenantUnchanged() {
      return !('gymId' in resource.data) || request.resource.data.gymId == resource.data.gymId;
    }
    function tenantValid(gymId) {
      return !('gymId' in request.resource.data) || request.resource.data.gymId == gymId;
    }
    function identityValid(uid) {
      return !('uid' in request.resource.data) || request.resource.data.uid == uid;
    }

    match /users/{uid} {
      allow read, update, delete: if signedIn() && request.auth.uid == uid || platformAdmin();
      allow create: if signedIn() && request.auth.uid == uid;

      match /device_tokens/{tokenId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /gym_memberships/{id} {
      allow read: if platformAdmin() || (signedIn() && resource.data.uid == request.auth.uid) ||
        permission(resource.data.gymId, 'staff.manage');
      allow write: if false;
    }

    match /saas_plans/{planId} {
      allow read: if (signedIn() && resource.data.status == 'active' && resource.data.isPublic == true) || platformAdmin();
      allow write: if false;
    }

    match /platform_upgrade_requests/{gymId} {
      allow read: if platformAdmin() || role(gymId, ['owner']);
      allow write: if false;
    }

    match /trial_claims/{uid} {
      allow read, write: if false;
    }

    match /gyms/{gymId} {
      allow read: if platformAdmin() || activeGym(gymId);
      allow write: if false;

      match /public/{document=**} {
        allow read: if true;
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if platformAdmin() || (activeGym(gymId) && request.auth.uid == uid) ||
          permission(gymId, 'members.read') || role(gymId, ['trainer']);
        allow create: if false;
        allow update: if tenantValid(gymId) && identityValid(uid) &&
          activeGym(gymId) && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'photoUrl', 'dateOfBirth', 'gender', 'updatedAt'
          ]);
        allow delete: if permission(gymId, 'members.delete');
      }

      match /staff/{uid} {
        allow read: if platformAdmin() || request.auth.uid == uid || permission(gymId, 'staff.read');
        allow write: if false;
      }

      match /invitations/{inviteId} {
        allow read: if permission(gymId, 'staff.manage') || permission(gymId, 'members.write');
        allow write: if false;
      }

      match /membership_plans/{planId} {
        allow read: if activeGym(gymId);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if platformAdmin() ||
          (activeGym(gymId) && subscriptionId == request.auth.uid) ||
          permission(gymId, 'subscriptions.read');
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if platformAdmin() || resource.data.memberUid == request.auth.uid ||
          permission(gymId, 'payments.read');
        allow write: if false;
      }

      match /renewal_requests/{requestId} {
        allow read: if platformAdmin() ||
          (activeGym(gymId) && requestId == request.auth.uid) ||
          permission(gymId, 'payments.read');
        allow write: if false;
      }

      match /attendance/{attendanceId} {
        allow read: if platformAdmin() || resource.data.memberUid == request.auth.uid ||
          permission(gymId, 'attendance.read') || role(gymId, ['trainer']);
        allow write: if false;
      }

      match /qr_sessions/{sessionId} {
        allow read: if permission(gymId, 'attendance.manage');
        allow write: if false;
      }

      match /class_sessions/{sessionId} {
        allow read: if activeGym(gymId);
        allow write: if false;
      }

      match /platform_subscription/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner']);
        allow write: if false;
      }

      match /entitlements/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner', 'manager']);
        allow write: if false;
      }

      match /usage/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner', 'manager']);
        allow write: if false;
      }

      match /class_bookings/{bookingId} {
        allow read: if activeGym(gymId) &&
          (resource.data.memberUid == request.auth.uid || permission(gymId, 'classes.manage'));
        allow write: if false;
      }

      match /exercises/{exerciseId} {
        allow read: if activeGym(gymId);
        allow create, update: if permission(gymId, 'fitness.manage') && tenantValid(gymId);
        allow delete: if permission(gymId, 'fitness.manage');
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments',
          'diet_assignments', 'goals', 'measurements', 'personal_records',
          'workout_logs', 'progress_photos'
        ] && activeGym(gymId) &&
          (resource.data.memberUid == request.auth.uid ||
           role(gymId, ['trainer']) || permission(gymId, 'fitness.manage'));
        allow create, update: if collection in ['goals', 'measurements', 'personal_records', 'workout_logs', 'progress_photos'] &&
          activeGym(gymId) && request.resource.data.memberUid == request.auth.uid && tenantValid(gymId);
        allow create, update: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments', 'diet_assignments'
        ] && permission(gymId, 'fitness.manage') && tenantValid(gymId);
        allow delete: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments', 'diet_assignments'
        ] && permission(gymId, 'fitness.manage');
      }

      match /conversations/{conversationId} {
        allow read: if activeGym(gymId) && request.auth.uid in resource.data.participantUids;
        allow create: if false;
        allow update: if activeGym(gymId) && request.auth.uid in resource.data.participantUids &&
          request.resource.data.participantUids == resource.data.participantUids && tenantUnchanged() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadBy', 'updatedAt']);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if activeGym(gymId) && request.auth.uid in
            get(/databases/$(database)/documents/gyms/$(gymId)/conversations/$(conversationId)).data.participantUids;
          allow create: if activeGym(gymId) && request.resource.data.senderUid == request.auth.uid &&
            tenantValid(gymId) && request.auth.uid in
            get(/databases/$(database)/documents/gyms/$(gymId)/conversations/$(conversationId)).data.participantUids;
          allow update, delete: if false;
        }
      }

      match /announcements/{announcementId} {
        allow read: if activeGym(gymId);
        allow create, update: if permission(gymId, 'announcements.manage') && tenantValid(gymId);
        allow delete: if permission(gymId, 'announcements.manage');
      }

      match /notifications/{notificationId} {
        allow read: if activeGym(gymId) && resource.data.recipientUid == request.auth.uid;
        allow update: if activeGym(gymId) && resource.data.recipientUid == request.auth.uid &&
          tenantUnchanged() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }

      match /audit_logs/{logId} {
        allow read: if platformAdmin() || permission(gymId, 'audit.read');
        allow write: if false;
      }

      match /dashboard_metrics/{metricId} {
        allow read: if permission(gymId, 'dashboard.read');
        allow write: if false;
      }
    }
  }
}
