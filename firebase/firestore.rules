rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function platformAdmin() {
      return signedIn() && 'platformAdmin' in request.auth.token &&
        request.auth.token.platformAdmin == true;
    }
    function membershipId(gymId) { return gymId + '_' + request.auth.uid; }
    function membership(gymId) {
      return get(/databases/$(database)/documents/gym_memberships/$(membershipId(gymId))).data;
    }
    function activeGym(gymId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/gym_memberships/$(membershipId(gymId))) &&
        membership(gymId).status == 'active' &&
        get(/databases/$(database)/documents/gyms/$(gymId)).data.status in ['trial', 'active'] &&
        (!('platformPlanEndsAt' in get(/databases/$(database)/documents/gyms/$(gymId)).data) ||
         get(/databases/$(database)/documents/gyms/$(gymId)).data.platformPlanEndsAt > request.time);
    }
    function role(gymId, allowed) {
      return activeGym(gymId) && membership(gymId).role in allowed;
    }
    function permission(gymId, key) {
      return activeGym(gymId) && membership(gymId).permissions[key] == true;
    }
    function activeSubjectMembership(gymId, uid) {
      return exists(/databases/$(database)/documents/gym_memberships/$(gymId + '_' + uid)) &&
        get(/databases/$(database)/documents/gym_memberships/$(gymId + '_' + uid)).data.status == 'active';
    }
    function activeSharingProjection(gymId, uid) {
      return activeSubjectMembership(gymId, uid) &&
        exists(/databases/$(database)/documents/gyms/$(gymId)/shared_fitness/$(uid)) &&
        (!('revokedAt' in get(/databases/$(database)/documents/gyms/$(gymId)/shared_fitness/$(uid)).data) ||
         get(/databases/$(database)/documents/gyms/$(gymId)/shared_fitness/$(uid)).data.revokedAt == null);
    }
    function tenantUnchanged() {
      return !('gymId' in resource.data) || request.resource.data.gymId == resource.data.gymId;
    }
    function tenantValid(gymId) {
      return !('gymId' in request.resource.data) || request.resource.data.gymId == gymId;
    }
    function identityValid(uid) {
      return !('uid' in request.resource.data) || request.resource.data.uid == uid;
    }
    function activeConsumer(uid) {
      return signedIn() && request.auth.uid == uid &&
        (!exists(/databases/$(database)/documents/users/$(uid)) ||
         !('status' in get(/databases/$(database)/documents/users/$(uid)).data) ||
         get(/databases/$(database)/documents/users/$(uid)).data.status == 'active');
    }
    function consentedConsumer(uid) {
      return activeConsumer(uid) &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        'ageConfirmedAt' in get(/databases/$(database)/documents/users/$(uid)).data &&
        'termsAcceptedAt' in get(/databases/$(database)/documents/users/$(uid)).data &&
        'termsVersion' in get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function consentedConsumerAfter(uid) {
      return signedIn() && request.auth.uid == uid &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'active' &&
        'ageConfirmedAt' in getAfter(/databases/$(database)/documents/users/$(uid)).data &&
        'termsAcceptedAt' in getAfter(/databases/$(database)/documents/users/$(uid)).data &&
        'termsVersion' in getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }
    function personalOwnerValid(uid) {
      return !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == uid;
    }
    function validMemberProfile(gymId, uid) {
      return (!('displayName' in request.resource.data) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() >= 2 &&
           request.resource.data.displayName.size() <= 100)) &&
        (!('phone' in request.resource.data) || request.resource.data.phone == null ||
          (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)) &&
        (!('heightCm' in request.resource.data) || request.resource.data.heightCm == null ||
          (request.resource.data.heightCm is number && request.resource.data.heightCm >= 80 &&
           request.resource.data.heightCm <= 260)) &&
        (!('weightKg' in request.resource.data) || request.resource.data.weightKg == null ||
          (request.resource.data.weightKg is number && request.resource.data.weightKg >= 20 &&
           request.resource.data.weightKg <= 500)) &&
        (!('experienceLevel' in request.resource.data) ||
          request.resource.data.experienceLevel in ['beginner', 'intermediate', 'advanced']) &&
        (!('fitnessGoals' in request.resource.data) ||
          (request.resource.data.fitnessGoals is list &&
           (gymId == 'personal' || request.resource.data.fitnessGoals.size() >= 1) &&
           request.resource.data.fitnessGoals.size() <= 5)) &&
        (!('equipmentAccess' in request.resource.data) ||
          (request.resource.data.equipmentAccess is list &&
           (gymId == 'personal' || request.resource.data.equipmentAccess.size() >= 1) &&
           request.resource.data.equipmentAccess.size() <= 5)) &&
        (!('workoutDaysPerWeek' in request.resource.data) ||
          (request.resource.data.workoutDaysPerWeek is int &&
           request.resource.data.workoutDaysPerWeek >= 1 &&
           request.resource.data.workoutDaysPerWeek <= 7)) &&
        (!('limitations' in request.resource.data) || request.resource.data.limitations == null ||
          (request.resource.data.limitations is string &&
           request.resource.data.limitations.size() <= 1000)) &&
        (!('photoPath' in request.resource.data) ||
          (request.resource.data.photoPath is string &&
           (request.resource.data.photoPath.matches('gyms/' + gymId + '/profiles/' + uid + '/.*') ||
            (gymId == 'personal' &&
             request.resource.data.photoPath.matches('users/' + uid + '/profile/.*')))));
    }

    match /users/{uid} {
      // The root document is an account summary. Health and fitness records
      // below it never inherit platform-administrator access.
      allow read: if activeConsumer(uid) || platformAdmin();
      allow update: if activeConsumer(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'ageConfirmedAt', 'termsAcceptedAt',
          'termsVersion', 'onboardingCompletedAt', 'updatedAt'
        ]);
      allow delete: if false;
      allow create: if signedIn() && request.auth.uid == uid;

      match /device_tokens/{tokenId} {
        allow read, create, update, delete: if activeConsumer(uid);
      }

      match /fitness_profile/{documentId} {
        allow read: if consentedConsumer(uid);
        allow create, update: if consentedConsumerAfter(uid) && personalOwnerValid(uid) &&
          validMemberProfile('personal', uid);
        allow delete: if consentedConsumer(uid);
      }

      match /entitlements/{documentId} {
        allow read: if activeConsumer(uid);
        allow write: if false;
      }

      match /gym_shares/{gymId} {
        allow read: if activeConsumer(uid);
        allow write: if false;
      }

      match /support_history/{grantId} {
        allow read: if activeConsumer(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if activeConsumer(uid);
        allow update: if activeConsumer(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'routines', 'workout_logs', 'measurements', 'goals',
          'personal_records', 'progress_photos'
        ] && consentedConsumer(uid);
        allow create, update: if collection in [
          'routines', 'workout_logs', 'measurements', 'goals',
          'personal_records', 'progress_photos'
        ] && consentedConsumerAfter(uid) && personalOwnerValid(uid);
        allow delete: if collection in [
          'routines', 'workout_logs', 'measurements', 'goals',
          'personal_records', 'progress_photos'
        ] && consentedConsumer(uid);
      }
    }

    match /platform_public/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /consumer_plans/{planId} {
      allow read: if (signedIn() && resource.data.status == 'active' &&
        resource.data.isPublic == true) || platformAdmin();
      allow write: if false;
    }

    match /gym_memberships/{id} {
      allow read: if platformAdmin() || (signedIn() && resource.data.uid == request.auth.uid) ||
        permission(resource.data.gymId, 'staff.manage');
      allow write: if false;
    }

    match /saas_plans/{planId} {
      allow read: if (signedIn() && resource.data.status == 'active' && resource.data.isPublic == true) || platformAdmin();
      allow write: if false;
    }

    match /platform_upgrade_requests/{gymId} {
      allow read: if platformAdmin() || role(gymId, ['owner']);
      allow write: if false;
    }

    match /platform_feature_metrics/{featureId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /platform_feedback/{feedbackId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /trial_claims/{uid} {
      allow read, write: if false;
    }

    match /gyms/{gymId} {
      allow read: if platformAdmin() || activeGym(gymId);
      allow write: if false;

      match /public/{document=**} {
        allow read: if true;
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if platformAdmin() || (activeGym(gymId) && request.auth.uid == uid) ||
          permission(gymId, 'members.read') || role(gymId, ['trainer']);
        allow create: if false;
        allow update: if tenantValid(gymId) && identityValid(uid) &&
          activeGym(gymId) && request.auth.uid == uid &&
          validMemberProfile(gymId, uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'photoUrl', 'photoPath', 'dateOfBirth', 'gender',
            'heightCm', 'weightKg', 'experienceLevel', 'fitnessGoals',
            'workoutDaysPerWeek', 'equipmentAccess', 'limitations',
            'onboardingCompletedAt', 'updatedAt'
          ]);
        allow delete: if permission(gymId, 'members.delete');
      }

      match /staff/{uid} {
        allow read: if platformAdmin() || request.auth.uid == uid || permission(gymId, 'staff.read');
        allow write: if false;
      }

      match /invitations/{inviteId} {
        allow read: if permission(gymId, 'staff.manage') || permission(gymId, 'members.write');
        allow write: if false;
      }

      match /membership_plans/{planId} {
        allow read: if activeGym(gymId);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if platformAdmin() ||
          (activeGym(gymId) && subscriptionId == request.auth.uid) ||
          permission(gymId, 'subscriptions.read');
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if platformAdmin() || resource.data.memberUid == request.auth.uid ||
          permission(gymId, 'payments.read');
        allow write: if false;
      }

      match /renewal_requests/{requestId} {
        allow read: if platformAdmin() ||
          (activeGym(gymId) && requestId == request.auth.uid) ||
          permission(gymId, 'payments.read');
        allow write: if false;
      }

      match /attendance/{attendanceId} {
        allow read: if platformAdmin() || resource.data.memberUid == request.auth.uid ||
          permission(gymId, 'attendance.read') || role(gymId, ['trainer']);
        allow write: if false;
      }

      match /qr_sessions/{sessionId} {
        allow read: if permission(gymId, 'attendance.manage');
        allow write: if false;
      }

      match /class_sessions/{sessionId} {
        allow read: if activeGym(gymId);
        allow write: if false;
      }

      match /platform_subscription/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner']);
        allow write: if false;
      }

      match /entitlements/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner', 'manager']);
        allow write: if false;
      }

      match /usage/{documentId} {
        allow read: if platformAdmin() || role(gymId, ['owner', 'manager']);
        allow write: if false;
      }

      match /class_bookings/{bookingId} {
        allow read: if activeGym(gymId) &&
          (resource.data.memberUid == request.auth.uid || permission(gymId, 'classes.manage'));
        allow write: if false;
      }

      match /exercises/{exerciseId} {
        allow read: if activeGym(gymId);
        allow create, update: if permission(gymId, 'fitness.manage') && tenantValid(gymId);
        allow delete: if permission(gymId, 'fitness.manage');
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments',
          'diet_assignments', 'goals', 'measurements', 'personal_records',
          'workout_logs', 'progress_photos', 'member_routines'
        ] && activeGym(gymId) &&
          (resource.data.memberUid == request.auth.uid ||
           role(gymId, ['trainer']) || permission(gymId, 'fitness.manage'));
        allow create: if collection in ['goals', 'measurements', 'personal_records', 'workout_logs', 'progress_photos', 'member_routines'] &&
          activeGym(gymId) && request.resource.data.memberUid == request.auth.uid && tenantValid(gymId);
        allow update: if collection in ['goals', 'measurements', 'personal_records', 'workout_logs', 'progress_photos', 'member_routines'] &&
          activeGym(gymId) && resource.data.memberUid == request.auth.uid &&
          request.resource.data.memberUid == request.auth.uid && tenantValid(gymId);
        allow delete: if collection == 'member_routines' && activeGym(gymId) &&
          resource.data.memberUid == request.auth.uid;
        allow create, update: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments', 'diet_assignments'
        ] && permission(gymId, 'fitness.manage') && tenantValid(gymId);
        allow delete: if collection in [
          'workout_templates', 'diet_templates', 'workout_assignments', 'diet_assignments'
        ] && permission(gymId, 'fitness.manage');
      }

      match /conversations/{conversationId} {
        allow read: if activeGym(gymId) && request.auth.uid in resource.data.participantUids;
        allow create: if false;
        allow update: if activeGym(gymId) && request.auth.uid in resource.data.participantUids &&
          request.resource.data.participantUids == resource.data.participantUids && tenantUnchanged() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadBy', 'updatedAt']);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if activeGym(gymId) && request.auth.uid in
            get(/databases/$(database)/documents/gyms/$(gymId)/conversations/$(conversationId)).data.participantUids;
          allow create: if activeGym(gymId) && request.resource.data.senderUid == request.auth.uid &&
            tenantValid(gymId) && request.auth.uid in
            get(/databases/$(database)/documents/gyms/$(gymId)/conversations/$(conversationId)).data.participantUids;
          allow update, delete: if false;
        }
      }

      match /announcements/{announcementId} {
        allow read: if activeGym(gymId);
        allow create, update: if permission(gymId, 'announcements.manage') && tenantValid(gymId);
        allow delete: if permission(gymId, 'announcements.manage');
      }

      match /notifications/{notificationId} {
        allow read: if activeGym(gymId) && resource.data.recipientUid == request.auth.uid;
        allow update: if activeGym(gymId) && resource.data.recipientUid == request.auth.uid &&
          tenantUnchanged() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }

      match /audit_logs/{logId} {
        allow read: if platformAdmin() || permission(gymId, 'audit.read');
        allow write: if false;
      }

      match /dashboard_metrics/{metricId} {
        allow read: if permission(gymId, 'dashboard.read');
        allow write: if false;
      }

      match /feature_metrics/{featureId} {
        allow read: if platformAdmin() || role(gymId, ['owner', 'manager']);
        allow write: if false;
      }

      match /shared_fitness/{uid} {
        allow read: if activeGym(gymId) && activeSubjectMembership(gymId, uid) &&
          (!('revokedAt' in resource.data) || resource.data.revokedAt == null) &&
          (request.auth.uid == uid || role(gymId, ['owner', 'manager', 'trainer']) ||
           permission(gymId, 'fitness.manage'));
        allow write: if false;

        match /{collection}/{documentId} {
          allow read: if activeGym(gymId) && activeSharingProjection(gymId, uid) &&
            (request.auth.uid == uid || role(gymId, ['owner', 'manager', 'trainer']) ||
             permission(gymId, 'fitness.manage'));
          allow write: if false;
        }
      }
    }
  }
}
