rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function membership(gymId) {
      return firestore.get(/databases/(default)/documents/gym_memberships/$(gymId + '_' + request.auth.uid)).data;
    }
    function activeGym(gymId) {
      return signedIn() && membership(gymId).status == 'active' &&
        firestore.get(/databases/(default)/documents/gyms/$(gymId)).data.status in ['trial', 'active'];
    }
    function staff(gymId) {
      return activeGym(gymId) && membership(gymId).role in ['owner', 'manager', 'trainer'];
    }
    function conversationParticipant(gymId, conversationId) {
      return activeGym(gymId) && request.auth.uid in
        firestore.get(/databases/(default)/documents/gyms/$(gymId)/conversations/$(conversationId)).data.participantUids;
    }
    function safeImage() {
      return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    function safeMedia() {
      return request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('(image|video)/.*');
    }

    match /gyms/{gymId}/branding/{fileName} {
      allow read: if true;
      allow write: if staff(gymId) && safeImage();
    }

    match /gyms/{gymId}/exercise-media/{fileName} {
      allow read: if activeGym(gymId);
      allow write: if staff(gymId) && safeMedia();
    }

    match /gyms/{gymId}/progress/{uid}/{fileName} {
      allow read: if activeGym(gymId) && (request.auth.uid == uid || staff(gymId));
      allow write: if activeGym(gymId) && request.auth.uid == uid && safeImage();
    }

    match /gyms/{gymId}/chat/{conversationId}/{fileName} {
      allow read: if conversationParticipant(gymId, conversationId);
      allow write: if conversationParticipant(gymId, conversationId) && safeMedia();
    }
  }
}
