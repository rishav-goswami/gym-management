{
  "functions": {
    "source": "firebase/functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix firebase/functions run build"]
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "remoteconfig": {
    "template": "firebase/remoteconfig.template.json"
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "storage": { "host": "0.0.0.0", "port": 9199 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
